





'''
-If test statistics value increases then p-value decreases.
-If test statistics value decreases then p-value  increases.
'''


import pandas as pd


from scipy import stats





df=pd.read_csv('Dataset/pizza_sales.csv')
df.head()


df.info()


sample_mean=15
pop=df['total_price']
alpha= 0.05


#stats.ttest_1samp(sample_mean, population)
stats.ttest_1samp(pop, popmean=sample_mean)





#(actual_mean- sample_mean)/(sd)/root(total_number_of_data)


#Formula & Working of the formula inside the function

import numpy as np
actual_mean=df['total_price'].mean()
sd=df['total_price'].std()
first_val= actual_mean - sample_mean
bot_val = sd/np.sqrt (48629)


# stats.ttest_1samp(population, sample_mean)
t_stats, p_value=stats.ttest_1samp(pop, popmean=sample_mean)


Ho='Ho:Average total price of all pizza sales is equal to $15'
Ha='Ha:Average total price of all pizza sales is not equal to $15'

print(f'{Ho}')
print(f'{Ha}')
print(f'Statistics:{t_stats:,.2f}')
print(f'Probability Value:{p_value:,.2f}')
print(f'Actual Average Price:Rs.{df['total_price'].mean():,.2f}')
print(f'Sample Average Price:{sample_mean}')


if p_value<alpha:
    print(f"Decision failed to accept null hypothesis. \nConclusion: Needs to accept alternate hypothesis.\n{Ha}")
else:
    print(f"Decision failed to reject null hypothesis. \nConclusion: Needs to accept null  hypothesis.\n{Ho}")









alpha = 0.05
classic_price = df[df['pizza_category']=='Classic']['unit_price']
chicken_price = df[df['pizza_category']=='Chicken']['unit_price']


# stats.ttest_ind(cat1, cat2, equal_var= False)
stats.ttest_ind(classic_price, chicken_price, equal_var= False)


Ho = 'Ho: Average unit price of all Classic pizza and Chicken pizza are equal'
Ha = 'Ha: Average unit price of all Classic pizza and Chicken pizza is not equal'

print(f'{Ho}')
print(f'{Ha}')
print(f'Statistics: {t_stats:,.2f}')
print(f'Probability Value: {p_value:,.2f}')

print(f'Actual Average Classic Pizza Price: Rs.{classic_price.mean():,.2f}')
print(f'Actual Average Chicken Pizza Price: Rs.{chicken_price.mean():,.2f}')


if p_value<alpha:
    print(f"Decision failed to accept null hypothesis. \nConclusion: Needs to accept alternate hypothesis.\n{Ha}")
else:
    print(f"Decision failed to reject null hypothesis. \nConclusion: Needs to accept null  hypothesis.\n{Ho}")






''' Three or more than three independent category
-Just like 2 sample t-test just here the value is three or more '''






categories = df['pizza_category'].unique()
categories


grouped_price=[]




for category in categories:
    prices = df[df['pizza_category'] == category]['total_price']
    grouped_price.append(prices)


print(grouped_price)


t_statistics, p_value = stats.f_oneway(*grouped_price)


category_price = df.groupby('pizza_category')['total_price'].sum()
format_table = category_price.map("Rs.{:,.2f}".format).to_markdown(
                                                            numalign='center', stralign='center'
)
print(format_table)


Ho = 'Ho: Average total price of all  pizza are equal'
Ha = 'Ha: Average total price of all pizza is not equal'
print(Ho)
print(Ha)
print('-'*36)
print(format_table)
print('-'*36)

print(f'T-Statistics: {t_statistics}')
print(f'probability value: {p_value}')



if p_value<alpha:
