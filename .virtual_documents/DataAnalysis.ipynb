Date Time
--------
Time Intelligence Function

MoM-> Month Over Month Growth
YoY->Year Over Year Growth

PMTD -> Previous Month to Date
PYTD -> Previous Year to Date

CMTD -> Current Month to Date
CYTD -> Current Year to Date


df['HIRE_DATE']= pd.to_datetime(df['HIRE_DATE'])


df['HIRE_DATE'] = pd.to_datetime(df['HIRE_DATE'])

df['HIRE_YEAR'] = df['HIRE_DATE'].dt.year
df['HIRE_MONTH'] = df['HIRE_DATE'].dt.month_name()
df['HIRE_DAY'] = df['HIRE_DATE'].dt.day_name()


df


''' 
1. Find total employees hired in each day.
2. Find total employees hired in each month.
'''


weekdays=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']
df['HIRE_DAY']= pd.Categorical(df['HIRE_DAY'],categories = weekdays)


emp_day = df.groupby(df['HIRE_DAY'], observed= False)['EMPLOYEE_ID'].count().reset_index()
emp_day


df['HIRE_MONTH_NUM']=df['HIRE_DATE'].dt.month


month_emp= df.groupby(['HIRE_MONTH','HIRE_MONTH_NUM'])['EMPLOYEE_ID'].count().reset_index()
month_emp


month_emp= df.groupby(['HIRE_MONTH_NUM','HIRE_MONTH'])['EMPLOYEE_ID'].count().reset_index()
month_emp


month_emp = df.groupby(['HIRE_MONTH_NUM', 'HIRE_MONTH']).agg(
    Total_Employees=('EMPLOYEE_ID', 'count')
).reset_index()

month_data = month_emp[['HIRE_MONTH', 'Total_Employees']]
    


