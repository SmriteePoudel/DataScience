ENGLISH_STOP_WORDS


def cleanText(text):
    text = re.sub(r'<.*?>', '', text)
    text = re.sub(r'[^A-Za-z]', '',text)
    text = re.sub(r'\s+', ' ' ,text)
    return text


df['review']=df['review'].apply(cleanText)


df


X= df[['review']]
Y=df['sentiment']



X_train, X_test,Y_train, Y_test = train_test_split(
    X,Y, test_size=0.2, random_state= 42, stratify = Y
 

)



