#Find total employees working in each departemt


#For formatting use // reset_index()
emp_dep = df.groupby('DEPARTMENT_ID')['EMPLOYEE_ID'].count().reset_index()
emp_dep


#Formatting using markdown
emp_dep = df.groupby('DEPARTMENT_ID')['EMPLOYEE_ID'].count()

format_data = emp_dep.to_markdown(stralign='center', numalign= 'center')
print(format_data)


emp_dep = df.groupby('DEPARTMENT_ID')['EMPLOYEE_ID'].count().reset_index().rename(columns= {
     'EMPLOYEE_ID':'count of employees', ' DEPARTMENT_ID':' Departments'
    
})

emp_dep






