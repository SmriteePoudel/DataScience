import pandas as pd


df = pd.read_csv('Dataset/pizza_sales.csv')
df.head()


df.info()


df.isnull().sum()


df['order_date'] = pd.to_datetime(df['order_date'], dayfirst=True)

df['day'] = df['order_date'].dt.day_name()
df['month'] = df['order_date'].dt.month_name()


df['total_price'].sum()



df['order_id'].nunique()


