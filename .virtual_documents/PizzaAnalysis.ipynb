import pandas as pd


df = pd.read_csv('Dataset/pizza_sales.csv')
df.head()


df.info()


df.isnull().sum()


df['order_date'] = pd.to_datetime(df['order_date'], dayfirst=True)

df['day'] = df['order_date'].dt.day_name()
df['month'] = df['order_date'].dt.month_name()


df['total_price'].sum()



df['order_id'].nunique()


df['quantity'].sum()


df.groupby('order_id')['total_price'].sum().mean()


df.groupby('pizza_name')['quantity'].sum().sort_values(ascending=False)


df.groupby('pizza_name')['total_price'].sum().sort_values(ascending=False)


df.groupby('pizza_category')['total_price'].sum()


df.groupby('pizza_size')['total_price'].sum()


df.groupby('hour')['total_price'].sum()


df.groupby('day')['total_price'].sum()



df['hour'] = df['order_date'].dt.hour

df.groupby('hour')['total_price'].sum()



